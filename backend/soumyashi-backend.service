[Unit]
Description=Soumyashi Power FastAPI Backend
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/soumyashi-backend
Environment="PATH=/var/www/soumyashi-backend/venv/bin"
ExecStart=/var/www/soumyashi-backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
