# Application
APP_NAME=Soumyashi Power API
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars

# CORS - Frontend URLs
ALLOWED_ORIGINS=https://www.soumyashipower.in,https://soumyashipower.in,http://localhost:3000

# MongoDB
MONGODB_URL=mongodb://username:password@your-vps-ip:27017/soumyashi_power
MONGODB_DB_NAME=soumyashi_power

# JWT Auth (Admin Panel)
JWT_SECRET_KEY=change-this-to-another-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Gmail SMTP (for email notifications)
GMAIL_USER=soumyashipower@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password

# Admin Email (receives all notifications)
ADMIN_EMAIL=soumyashipower@gmail.com
ADMIN_PHONE=+919437611129
ADMIN_PHONE2=+917381076808

# Cloudinary (file uploads - land documents)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Company Info
COMPANY_NAME=Soumyashi Power Limited
COMPANY_ADDRESS=MIG-126, Bhimatangi Housing Colony, Bhubaneswar, Odisha 751002
COMPANY_WEBSITE=https://www.soumyashipower.in
