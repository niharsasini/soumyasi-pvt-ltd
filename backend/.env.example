# Application
APP_NAME=Soumyashi Power API
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=https://soumyashipower.in,https://www.soumyashipower.in

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/soumyashi_power

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=soumyashipower@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=soumyashipower@gmail.com
EMAIL_FROM_NAME=Soumyashi Power

# Admin notifications
ADMIN_EMAIL=soumyashipower@gmail.com
ADMIN_PHONE=+919437611129

# WhatsApp (optional - Twilio or WATI)
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE=+919437611129

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
